{
  "name": "parcel-hub-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "admin:promote": "node dist/commands/promote-admin.js",
    "admin:promote:dev": "tsx src/commands/promote-admin.ts",
    "admin:list": "node dist/commands/list-admins.js",
    "admin:demote": "node dist/commands/demote-admin.js",
    "sessions:revoke": "node dist/commands/revoke-sessions.js",
    "user:disable": "node dist/commands/set-user-disabled.js disable",
    "user:enable": "node dist/commands/set-user-disabled.js enable",
    "referral:create": "node dist/commands/create-referral.js",
    "referral:revoke": "node dist/commands/revoke-referral.js",
    "db:push": "prisma db push",
    "db:migrate:deploy": "node dist/commands/deploy-migrations.js",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:baseline": "node dist/commands/baseline-migrations.js",
    "db:backup": "node dist/commands/backup-database.js",
    "db:restore": "node dist/commands/restore-database.js",
    "db:check": "node dist/commands/check-database.js",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "mail:up": "docker compose -f docker-compose.mailpit.yml up -d",
    "mail:down": "docker compose -f docker-compose.mailpit.yml down",
    "mail:logs": "docker compose -f docker-compose.mailpit.yml logs -f mailpit",
    "mail:test": "node dist/commands/test-mail.js",
    "uploads:check": "node dist/commands/check-uploads.js",
    "ops:doctor": "node dist/commands/doctor.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.25",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@prisma/client": "^6.5.0",
    "better-auth": "^1.6.25",
    "bwip-js": "^4.5.1",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.17.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bwip-js": "^3.2.3",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
