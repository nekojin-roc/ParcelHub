# Server and browser origins
PORT=3001
HOST=0.0.0.0
CLIENT_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3001

# Generate a production value with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Local SQLite database and private package photo storage
DATABASE_URL="file:./prisma/parcel-hub.db"
UPLOAD_DIR=uploads

# Development SMTP (Mailpit; package intake and pickup continue if delivery fails)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ParcelHub <no-reply@parcelhub.local>"
