generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Recipient {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  packages  Package[]
}

model Bin {
  id        String    @id @default(cuid())
  label     String    @unique  // e.g. "A-1", "Shelf-B"
  description String?          // e.g. "Top shelf, hallway closet"
  capacity  Int       @default(10)
  createdAt DateTime  @default(now())
  packages  Package[]
}

model Package {
  id            String        @id @default(cuid())
  barcode       String        @unique  // Internal barcode, e.g. "PKG-20260414-001"
  description   String?
  orderNumber   String?
  trackingNumber String?
  photoPath     String?                // Path to uploaded photo
  status        String        @default("RECEIVED")  // RECEIVED | NOTIFIED | PICKED_UP
  collectedBy   String?                // Name of person who picked it up
  receivedAt    DateTime      @default(now())
  notifiedAt    DateTime?
  pickedUpAt    DateTime?
  recipientId   String
  recipient     Recipient     @relation(fields: [recipientId], references: [id])
  binId         String?
  bin           Bin?          @relation(fields: [binId], references: [id])

  @@index([status])
  @@index([recipientId])
  @@index([barcode])
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("USER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
